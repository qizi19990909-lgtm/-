  "base_formula": {
    "unenhanced": "先定各等级白装武器，再乘品质倍率 1.00/1.03/1.06/1.10/1.15/1.20/1.28。其他部位按与武器的固定比例缩放。",
    "enhance_flat": "强化固定值与品阶无关，只与装备等级和强化等级有关。30级起：+1到+10每次+10攻击，+11到+15每次+15，+16到+20每次+20，+20共+275。30级前按装备等级缩小。",
    "gem_flat": "每颗同级攻击石约为该级白武器攻击的10%，是额外属性，按当前阶段怪来平衡，不跟下一阶段装备比。",
    "layer": "人物基础 + 装备裸装 + 强化固定值 + 词条/石头固定值 = 底层。再乘百分比，最后结算会心、技能、元素和防御。",
    "damage": "打怪伤害 = max(1, 攻击 - 怪物防御)。按单人主攻手估算。",
    "display": "强化和石头显示固定值，四舍五入为整数。"
  },
